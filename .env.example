# Discord Developer Portal -> your application -> Bot
DISCORD_BOT_TOKEN=

# Discord user IDs allowed to administer mappings and global settings.
# Enable Developer Mode in Discord, then right-click yourself -> Copy User ID.
BOT_OWNER_IDS=

# OpenShock account settings -> API Tokens
OPENSHOCK_TOKEN=

# Optional initial mapping. These can also be configured with /openshock link.
DEFAULT_TARGET_DISCORD_ID=
DEFAULT_SHOCKER_ID=

# Runtime
DATABASE_PATH=data/openshockbot.sqlite
OPENSHOCK_API_BASE=https://api.openshock.app
USER_AGENT=OpenShockBot/0.1.0

# Absolute bot-wide safety ceilings. Per-target ceilings can be lower.
GLOBAL_MAX_INTENSITY=50
GLOBAL_MAX_DURATION_MS=5000
DEFAULT_COOLDOWN_SECONDS=5

# Reaction controls
REACTION_SHOCK_EMOJI=⚡
REACTION_VIBRATE_EMOJI=🌊
REACTION_SOUND_EMOJI=🔊
